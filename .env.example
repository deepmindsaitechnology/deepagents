# Copy this file to .env. Never commit your actual API keys.
# Leave blank to use scripted demo mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional read-only source for migration from the earlier SQLite POC.
# Active storage uses DEEPAGENT_WORKBOOK, not this legacy database.
DEEPAGENT_DB=deepagent.db

# Excel table storage (one sheet per table). Use one Uvicorn worker.
DEEPAGENT_WORKBOOK=data/platform.xlsx
# One-time read-only migration of the old SQLite file into the demo account.
IMPORT_LEGACY_SQLITE=true

# Google OAuth: Web application, External audience, scopes openid/email/profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ characters) when Google OAuth is configured.
SESSION_SECRET=
# true when serving over HTTPS; false for local HTTP development only.
COOKIE_SECURE=false
